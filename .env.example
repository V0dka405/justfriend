# ==============================================================================
# Database Configuration (PostgreSQL / SQLite)
# ==============================================================================
# วาง Connection String ของ Cloud PostgreSQL ที่นี่ (เช่น Supabase, Neon, Railway, Aiven)
# ระบบจะเชื่อมต่อกับ PostgreSQL โดยอัตโนมัติ พร้อมรองรับ SSL connection
#
# ตัวอย่าง:
# DATABASE_URL=postgresql://postgres.xxxx:your-password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require
# หรือ Neon:
# DATABASE_URL=postgres://user:password@ep-cool-db.us-east-2.aws.neon.tech/neondb?sslmode=require
#
DATABASE_URL=

# (หมายเหตุ: หากเว้นว่างไว้ ระบบจะรันบน SQLite WAL Mode ให้อัตโนมัติทันที ทำให้ทดสอบในเครื่องได้ตลอดเวลา)

# ==============================================================================
# Admin & Server Configuration
# ==============================================================================
ADMIN_INITIAL_PASSWORD=admin1234
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
